{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shmindmaster.github.io/heatlot/schemas/scrap-rollup.schema.json",
  "title": "Weekly scrap cost rollup",
  "description": "Weekly scrap digest rollup derived exclusively from exports/erp/scrap-export.csv: per-week totals, per-cause current week cost against the trailing-4-week average, and the top mover by variance percentage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_type",
    "week_ending",
    "weeks_included",
    "weekly_totals",
    "by_cause",
    "top_mover",
    "generated_from"
  ],
  "properties": {
    "report_type": { "const": "scrap-rollup" },
    "week_ending": { "type": "string", "format": "date" },
    "weeks_included": { "type": "integer", "minimum": 1 },
    "weekly_totals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["week_ending", "cost_usd", "weight_lbs"],
        "properties": {
          "week_ending": { "type": "string", "format": "date" },
          "cost_usd": { "type": "integer" },
          "weight_lbs": { "type": "integer" }
        }
      }
    },
    "by_cause": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cause_code", "cause_text", "cell", "week_cost_usd", "trailing4_avg_usd", "variance_pct"],
        "properties": {
          "cause_code": { "type": "string", "pattern": "^(P0[1-3]|M0[1-3]|C0[12]|D0[12]|H01|S01)$" },
          "cause_text": { "type": "string" },
          "cell": { "type": "string" },
          "week_cost_usd": { "type": "integer" },
          "trailing4_avg_usd": { "type": "number" },
          "variance_pct": { "type": "number" }
        }
      }
    },
    "top_mover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cause_code", "cell", "variance_pct"],
      "properties": {
        "cause_code": { "type": "string", "pattern": "^(P0[1-3]|M0[1-3]|C0[12]|D0[12]|H01|S01)$" },
        "cell": { "type": "string" },
        "variance_pct": { "type": "number" }
      }
    },
    "generated_from": { "const": "exports/erp/scrap-export.csv" }
  }
}

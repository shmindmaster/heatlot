{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shmindmaster.github.io/heatlot/schemas/ncr-triage-output.schema.json",
  "title": "NCR triage output",
  "description": "Structured triage of a single nonconformance report: defect classification, cause code, repeat-offender analysis over the trailing 90 days, and a recommended disposition action. Cause codes are the foundry vocabulary P01-P03/M01-M03/C01-C02/D01-D02/H01/S01.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_type",
    "ncr_id",
    "defect_type",
    "cause_code",
    "confidence",
    "repeat_offender",
    "recommended_action",
    "evidence",
    "notes"
  ],
  "properties": {
    "report_type": { "const": "ncr-triage" },
    "ncr_id": { "type": "string", "pattern": "^NCR-2026-\\d{4}$" },
    "defect_type": {
      "enum": ["porosity", "shrinkage", "sand-inclusion", "misrun-cold-shut", "dimensional", "chemistry"]
    },
    "cause_code": { "type": "string", "pattern": "^(P0[1-3]|M0[1-3]|C0[12]|D0[12]|H01|S01)$" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "repeat_offender": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occurrence_count_90d", "prior_ncr_ids", "repeat_offender"],
      "properties": {
        "occurrence_count_90d": { "type": "integer", "minimum": 1 },
        "prior_ncr_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^NCR-2026-\\d{4}$" }
        },
        "repeat_offender": { "type": "boolean" }
      }
    },
    "recommended_action": { "type": "string" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ncr_path", "heat_number"],
      "properties": {
        "ncr_path": { "type": "string" },
        "heat_number": { "type": "integer" }
      }
    },
    "notes": { "type": "string" }
  }
}

    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Get one NCR in full, including repeat-offender history: prior NCRs on the same part + defect + cause within 90 days before its date.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "ncr_id": {
            "pattern": "^NCR-2026-\\d{4}$",
            "type": "string"
          }
        },
        "required": [
          "ncr_id"
        ],
        "type": "object"
      },
      "name": "get_ncr",
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": {},
        "properties": {
          "cause_code": {
            "type": "string"
          },
          "cause_text": {
            "type": "string"
          },
          "cell": {
            "type": "string"
          },
          "cost_impact_usd": {
            "type": "number"
          },
          "customer": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "defect_type": {
            "type": "string"
          },
          "disposition": {
            "type": "string"
          },
          "heat_number": {
            "type": "number"
          },
          "narrative": {
            "type": "string"
          },
          "ncr_id": {
            "type": "string"
          },
          "part_name": {
            "type": "string"
          },
          "part_number": {
            "type": "string"
          },
          "repeat_analysis": {
            "additionalProperties": false,
            "properties": {
              "occurrence_count_90d": {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              },
              "prior_occurrences": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "date": {
                      "type": "string"
                    },
                    "disposition": {
                      "type": "string"
                    },
                    "ncr_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ncr_id",
                    "date",
                    "disposition"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "repeat_offender": {
                "type": "boolean"
              }
            },
            "required": [
              "prior_occurrences",
              "occurrence_count_90d",
              "repeat_offender"
            ],
            "type": "object"
          },
          "severity": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "ncr_id",
          "date",
          "part_number",
          "heat_number",
          "defect_type",
          "cause_code",
          "cell",
          "severity",
          "disposition",
          "status",
          "cost_impact_usd",
          "part_name",
          "customer",
          "cause_text",
          "narrative",
          "repeat_analysis"
        ],
        "type": "object"
      },
      "title": "Get one NCR with repeat history"
    },
    {

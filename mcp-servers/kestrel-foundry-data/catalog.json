  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Get an audit scope with each evidence area resolved against the document index: present:true/false per area. Absent areas are the gap list.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "audit_id": {
            "enum": [
              "AUD-2026-S1"
            ],
            "type": "string"
          }
        },
        "required": [
          "audit_id"
        ],
        "type": "object"
      },
      "name": "get_audit_scope",
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "audit_id": {
            "type": "string"
          },
          "evidence_areas": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "area": {
                  "type": "string"
                },
                "expected_path": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "present": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "area",
                "expected_path",
                "present"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "gaps": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "area": {
                  "type": "string"
                },
                "expected_path": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "area",
                "expected_path"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          },
          "window": {
            "type": "string"
          }
        },
        "required": [
          "audit_id",
          "title",
          "window",
          "evidence_areas",
          "gaps"
        ],
        "type": "object"
      },
      "title": "Get an audit scope and its evidence gaps"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Fetch one document body by its indexed path. The sha256 is re-verified against the index before anything is returned; unindexed paths are refused.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "path": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "name": "get_document",
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "content": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256",
          "content"
        ],
        "type": "object"
      },
      "title": "Read one indexed document (hash-verified)"
    },
    {

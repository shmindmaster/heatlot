          },
          "found": {
            "type": "boolean"
          },
          "heat_number": {
            "type": "number"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "record_type": {
            "type": "string"
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "found",
          "heat_number",
          "record_type"
        ],
        "type": "object"
      },
      "title": "Get one certification record for a heat"
